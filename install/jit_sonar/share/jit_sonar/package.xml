<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jit_sonar</name>
  <version>0.1.0</version>
  <description>Sonar post-processing for the JIT submarine: gates the raw
    Ping360 echo to a rectangular zone so tank walls and ringdown are ignored.</description>
  <maintainer email="masoncisco@icloud.com">mason</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>ping360_sonar_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
